# ─────────────────────────────────────────────
# 기프티클릭 환경 설정
# 아래 내용을 .env 로 복사해서 사용하세요 (cp .env.example .env)
# Next.js가 dev/prod 실행 시 자동으로 로드합니다.
# ─────────────────────────────────────────────

# 기프티콘 발급 프로바이더:
#   sandbox(기본)  — 키 불필요, 기프티엘과 동일한 발급 플로우 재현 (개발/테스트)
#   manual         — 수동 발송(직접 전달): 당첨 시 발송 대기가 쌓이고 관리자가 직접 전달
#                    사업자 없이 학생 개발자가 실물 운영 가능
#   giftiel        — 기프티엘 실전 (파트너 키 필요)
#   paypal         — PayPal Payouts 자동 송금 (부모님 비즈니스 계정 + Payouts 승인 필요)
GIFTCON_PROVIDER=sandbox

# ── PayPal Payouts 자동 송금 시 설정 ──
# GIFTCON_PROVIDER=paypal
# PAYPAL_ENV=sandbox            (테스트: PayPal 개발자 샌드박스 / 실전: live)
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_CURRENCY=USD           (KRW는 Payouts 미지원)
# PAYPAL_KRW_RATE=1400          (상품 원화가치 → 송금 통화 환산 비율)
# PAYPAL_SENDER_NOTE=GiftClick prize

# ── 기프티엘(Giftiel) 실전 전환 시 설정 ──
# GIFTCON_PROVIDER=giftiel
# GIFTIEL_API_BASE=https://open-api.giftiel.com
# GIFTIEL_API_KEY=발급받은_파트너_API키
# GIFTIEL_PARTNER_CODE=파트너_기업코드
# GIFTIEL_CALLBACK_URL=https://your-domain.com/api/giftcon/callback
# (발급사 문서상 경로가 다륾면 아래로 오버라이드)
# GIFTIEL_PATH_GOODS=/goods/list
# GIFTIEL_PATH_ISSUE=/gift/coupon/issue
# GIFTIEL_PATH_CANCEL=/gift/coupon/cancel

# JWT 세션 서명 키 (프로덕션에서는 꼭 지정)
# SESSION_SECRET=길고_랜덤한_문자열

# 샌드박스 발급 실패 시뮬레이션 (테스트용, 1=항상 실패)
# GIFTCON_SANDBOX_FAIL=0

# SQLite 데이터 디렉터리 (기본: 프로젝트 루트/data)
# GC_DB_DIR=./data

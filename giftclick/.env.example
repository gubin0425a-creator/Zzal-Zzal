# ─────────────────────────────────────────────
# 기프티클릭 환경 설정
# 아래 내용을 .env 로 복사해서 사용하세요 (cp .env.example .env)
# Next.js가 dev/prod 실행 시 자동으로 로드합니다.
# ─────────────────────────────────────────────

# 기프티콘 발급 프로바이더:
#   sandbox(기본)  — 키 불필요, 기프티엘과 동일한 발급 플로우 재현 (개발/테스트)
#   manual         — 수동 발송(직접 전달): 당첨 시 발송 대기가 쌓이고 관리자가 직접 전달
#                    사업자 없이 학생 개발자가 실물 운영 가능
#   giftiel        — 기프티엘 실전 (파트너 키 필요)
#   paypal         — PayPal Payouts 자동 송금 (부모님 비즈니스 계정 + Payouts 승인 필요)
GIFTCON_PROVIDER=sandbox

# ── PayPal Payouts 자동 송금 시 설정 ──
# GIFTCON_PROVIDER=paypal
# PAYPAL_ENV=sandbox            (테스트: PayPal 개발자 샌드박스 / 실전: live)
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_CURRENCY=USD           (KRW는 Payouts 미지원)
# PAYPAL_KRW_RATE=1400          (상품 원화가치 → 송금 통화 환산 비율)
# PAYPAL_SENDER_NOTE=GiftClick prize

# ── 기프티엘(Giftiel) 실전 전환 시 설정 ──
# GIFTCON_PROVIDER=giftiel
# GIFTIEL_API_BASE=https://open-api.giftiel.com
# GIFTIEL_API_KEY=발급받은_파트너_API키
# GIFTIEL_PARTNER_CODE=파트너_기업코드
# GIFTIEL_CALLBACK_URL=https://your-domain.com/api/giftcon/callback
# (발급사 문서상 경로가 다륾면 아래로 오버라이드)
# GIFTIEL_PATH_GOODS=/goods/list
# GIFTIEL_PATH_ISSUE=/gift/coupon/issue
# GIFTIEL_PATH_CANCEL=/gift/coupon/cancel

# ── 📺 광고 수익화 — 두 가지 경로 (헷갈리면 아래 표!) ──
#
#   경로        ID 형식                      어디에 쓰이나
#   ─────────── ─────────────────────────── ──────────────────────────
#   웹 AdSense  ca-pub-XXXX                  브라우저 웹사이트의 <ins> 배너
#   앱 AdMob    ca-app-pub-XXXX~XXXX(앱ID)   안드로이드/iOS 앱 (이 프로젝트는 이쪽!)
#               ca-app-pub-XXXX/XXXX(광고단위)
#
# ※ ca-app-pub ID는 웹 <ins> 광고에 넣으면 작동하지 않습니다(반대도 마찬가지).
#
# ── 📱 AdMob 광고단위 (안드로이드 앱 보상형 광고) ──
# NEXT_PUBLIC_ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
# NEXT_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
# SSV(서버측검증): AdMob 콘솔 광고단위 → 리워드URL = https://YOUR-DOMAIN/api/ads/ssv
#   등록 + 배포 완료 후 아래를 "1"로 → 클라 대신 구글 서버가 지급을 직접 호출(조작 불가)
# NEXT_PUBLIC_ADS_SSV_ACTIVE=1
#
# ── 웹 AdSense 배너 (웹사이트에서 광고를 볼 경우만) ──
# 승인 전까지는 아래 기본값(테스트 광고)으로 동작합니다.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX   (웹은 "ca-pub"—ca-app-pub 아님!)
# NEXT_PUBLIC_ADSENSE_SLOT=1234567890

# 광고 시청 보상 & 한도 (서버가 강제 — 쿨타임/한도로 어뷰징 차단)
# ADS_REWARD_CREDITS=2        (광고 1회 시청 시 깨기권 지급, 1~10)
# ADS_DAILY_CAP=10            (1인당 하루 최대 시청 횟수)
# ADS_COOLDOWN_SEC=60         (재시청 쿨타임 초)
# ADS_EST_CPM_KRW=1000        (예상수익 '견적' 계산용 CPM, 실수익 아님)

# ── 🛒 실제 결제 (토스페이먼츠 · 부모님 사업자 필요) ──
# sandbox(기본) = 돈이 오가지 않는 테스트 결제 / toss = 실전 리다이렉트 결제
# PAY_PROVIDER=toss
# NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_XXXXXXXX   (토스 개발자센터 내 상점)
# TOSS_SECRET_KEY=test_sk_XXXXXXXX               (절대 브라우저/git 노출 금지!)
# PAY_PRICE_FEE_PCT=5          확정상품 직접구매 수수료 (판매가 = 가치 + n%, 100원 올림)
# PAY_SANDBOX_FAIL=0           1이면 테스트 결제가 항상 실패 (테스트용)

# JWT 세션 서명 키 (프로덕션에서는 꼭 지정)
# SESSION_SECRET=길고_랜덤한_문자열

# 샌드박스 발급 실패 시뮬레이션 (테스트용, 1=항상 실패)
# GIFTCON_SANDBOX_FAIL=0

# SQLite 데이터 디렉터리 (기본: 프로젝트 루트/data)
# GC_DB_DIR=./data
